{
  "name": "@kami-sama/cli",
  "version": "1.0.0",
  "description": "Kami Sama CLI — Terminal dashboard for managing your media platform",
  "private": true,
  "type": "module",
  "bin": {
    "kami": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/cli.js",
      "types": "./dist/cli.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/cli.ts --format esm --clean",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "@inquirer/prompts": "^7.5.0",
    "ora": "^8.2.0",
    "cli-table3": "^0.6.5",
    "conf": "^13.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26",
    "eslint": "^10",
    "tsup": "^8.4.0",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3"
  }
}
