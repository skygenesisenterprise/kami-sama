# ── Discord Bot ────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_COMMAND_SCOPE=global

# ── Redis (Optional) ───────────────────────────────────────
REDIS_PASSWORD=redis-default-password
REDIS_ENABLED=true
REDIS_REQUIRED=false
